.lab {
  min-height: 100vh;
  background: #f3f1ec;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}
.head { margin-bottom: 36rpx; }
.t1 { font-size: 44rpx; font-weight: 700; color: #222; }
.t2 { font-size: 24rpx; color: #888; margin-top: 10rpx; line-height: 1.6; }

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.06);
}
.swatches { display: flex; margin-bottom: 20rpx; }
.sw {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  border: 3rpx solid rgba(0, 0, 0, 0.08);
}
.name { font-size: 36rpx; font-weight: 700; color: #222; }
.desc { font-size: 26rpx; color: #666; margin: 10rpx 0 22rpx; }
.go { font-size: 26rpx; color: #b0793a; font-weight: 600; }

.tip {
  font-size: 22rpx;
  color: #a09a8e;
  line-height: 1.7;
  margin-top: 12rpx;
}
