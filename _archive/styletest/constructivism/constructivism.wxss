/* ===== 构成主义：红黑斜切 · 海报式 · 工业几何 ===== */
.page {
  min-height: 100vh;
  background: #f4efe6;
  padding: 24rpx 28rpx 40rpx;
  box-sizing: border-box;
  font-family: -apple-system, 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
}

/* 顶部工具条 */
.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.badge {
  background: #141414;
  color: #f4efe6;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  padding: 8rpx 16rpx;
  transform: skewX(-12deg);
}
.stat { font-size: 22rpx; color: #7a7264; font-weight: 600; }

/* 列表项：硬朗黑框 + 红色顶条 */
.item {
  display: flex;
  background: #fdfaf3;
  border: 4rpx solid #141414;
  border-top: 10rpx solid #d62828;
  margin-bottom: 30rpx;
  overflow: hidden;
}
.v1 { border-top-color: #141414; }
.v1 .visual { border-right-color: #d62828; }

/* 左侧视觉块：几何海报 */
.visual {
  position: relative;
  width: 216rpx;
  min-height: 224rpx;
  flex-shrink: 0;
  background: #efe7d7;
  border-right: 4rpx solid #141414;
  overflow: hidden;
}
.shape { position: absolute; }
/* 主对角色块 */
.shape-a {
  left: -35%;
  top: 24%;
  width: 180%;
  height: 34%;
  background: var(--c1, #d62828);
  transform: rotate(var(--tilt, -18deg));
}
/* 圆 */
.shape-b {
  right: 10%;
  bottom: 12%;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--c2, #141414);
}
/* 粗横杠 */
.shape-c {
  left: 12%;
  bottom: 20%;
  width: 84rpx;
  height: 12rpx;
  background: #141414;
}

/* 变体：换配色与倾角 */
.v0 { --c1: #d62828; --c2: #141414; --tilt: -18deg; }
.v1 { --c1: #141414; --c2: #d62828; --tilt: 22deg; }
.v2 { --c1: #d62828; --c2: #2a4a7a; --tilt: -32deg; }
.v3 { --c1: #2a4a7a; --c2: #d62828; --tilt: 12deg; }
.v4 { --c1: #141414; --c2: #b23a2f; --tilt: -10deg; }
.v5 { --c1: #b23a2f; --c2: #141414; --tilt: 28deg; }

/* 右侧信息 */
.info { flex: 1; padding: 24rpx 26rpx; min-width: 0; }
.title {
  font-size: 32rpx;
  font-weight: 900;
  color: #141414;
  letter-spacing: 2rpx;
  margin-bottom: 14rpx;
}
.meta {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
}
.tick {
  width: 12rpx;
  height: 12rpx;
  background: #d62828;
  margin: 12rpx 12rpx 0 0;
  flex-shrink: 0;
}
.v1 .tick { background: #2a4a7a; }
.line { font-size: 24rpx; color: #4a453b; line-height: 1.65; }

.stamp {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #f4efe6;
  background: #141414;
  padding: 6rpx 14rpx;
  transform: skewX(-12deg);
}
.v2 .stamp { background: #d62828; }

/* 底部状态 */
.footer { text-align: center; padding: 20rpx 0 8rpx; }
.footer text { font-size: 24rpx; color: #7a7264; font-weight: 600; white-space: pre-line; }
.footer .err { color: #b23a2f; font-weight: 800; }
